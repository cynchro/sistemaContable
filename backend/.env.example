APP_NAME=MyApp
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8077
APP_TIMEZONE=UTC

# Cifrado de secretos en reposo (App\Support\Crypto). Genera: openssl rand -hex 32
APP_ENCRYPTION_KEY=change-me-32-bytes-min

# JWT — genera una clave segura: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your-256-bit-secret-here-change-me

# AFIP/ARCA web services. AFIP_ENV: homologacion | produccion.
# Certificado X.509 + clave privada (rutas a archivos PEM). Probar: php modux afip:wsaa wsfe
AFIP_ENV=homologacion
AFIP_CUIT=
AFIP_CERT_PATH=
AFIP_KEY_PATH=
AFIP_KEY_PASSPHRASE=
# Alcance del padrón: a13 (default; constancia de inscripción — NO informa condición IVA
# ni actividad secundaria) o a4/a5 (padrón completo — sí las traen). Requiere que ARCA
# autorice ese WS en el certificado (Administrador de Relaciones → "Servicio Consulta
# Padron A4"). Una vez habilitado, cambiar a: AFIP_PADRON_ALCANCE=a4
AFIP_PADRON_ALCANCE=a13
JWT_TTL=86400
JWT_ALGO=HS256

# En Docker Compose (MySQL servicio moduxdb): DB_HOST=moduxdb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_database
DB_USER=root
DB_PASS=secret
# Solo para docker-compose.prod.yml: password de root del contenedor MySQL.
# Generá uno fuerte: openssl rand -hex 24
DB_ROOT_PASS=change-me-prod
# Conexiones PDO persistentes (mejor latencia; ajustá max_connections antes de activar).
DB_PERSISTENT=false

# Puerto del host donde se publica la app (docker-compose.prod.yml). Default 8080.
APP_PORT=8080

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=MyApp

# CORS: separar con comas para múltiples orígenes. Incluí el origen del frontend
# (Vite dev usa http://localhost:5173; agregá el dominio de producción cuando exista).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

LOG_CHANNEL=file
LOG_LEVEL=debug

DISPLAY_ERRORS=true

# IA (opcional) — add-on vía `composer require cynchro/modux-ia`.
# Las variables AI_*/LLAMA_*/RAG_* solo se necesitan si instalas el módulo IA.
# Ver la sección "Optional: AI module" en el README.

# Billing (opcional) — add-on vía `composer require cynchro/modux-billing cynchro/modux-billing-stripe`.
# Solo si instalas el módulo de billing (app/Modules/Billing):
#   BILLING_GATEWAY=stripe
#   STRIPE_API_KEY=        STRIPE_WEBHOOK_SECRET=   STRIPE_SUCCESS_URL=   STRIPE_CANCEL_URL=
#   MP_ACCESS_TOKEN=       MP_WEBHOOK_SECRET=       MP_BACK_URL=
# Ver la sección "Optional: Billing module" en el README.

# SIGE (sistemaCuarto) — autocompletar el alta de empresa por CUIT sin duplicar la carga.
# En Docker local, apunta al contenedor de sistemaCuarto en la red compartida (ver
# docker-compose.yml); en producción, al dominio público del SIGE.
SIGE_BASE_URL=http://sistema_cuarto_app:8000/api
SIGE_API_KEY=
SIGE_TIMEOUT=5
