<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" bootstrap="bootstrap/test.php" colors="true" stopOnFailure="false">
  <testsuites>
    <testsuite name="Unit">
      <directory>tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory>tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="APP_DEBUG" value="true"/>
    <env name="JWT_SECRET" value="test-secret-key-minimum-32-characters"/>
    <env name="APP_ENCRYPTION_KEY" value="test-encryption-key-minimum-32-characters"/>
    <env name="JWT_TTL" value="3600"/>
    <!-- DB_HOST/PORT/USER/PASS: sin force, para heredar los reales del entorno (p. ej.
         DB_HOST=moduxdb en este docker-compose) cuando ya están seteados a nivel SO, y
         caer a estos defaults (pensados para el service mysql de CI) cuando no lo están.
         DB_NAME SÍ lleva force="true": sin esto, un entorno con DB_NAME=modux ya seteado
         (como este contenedor) pisa el valor de este XML y FeatureTestCase::migrateFresh()
         terminaba corriendo DROP TABLE + migraciones sobre la base real de desarrollo. -->
    <env name="DB_HOST" value="127.0.0.1"/>
    <env name="DB_PORT" value="3306"/>
    <env name="DB_NAME" value="monolito_test" force="true"/>
    <env name="DB_USER" value="root"/>
    <env name="DB_PASS" value=""/>
    <env name="LOG_CHANNEL" value="stderr"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">app/</directory>
    </include>
  </source>
</phpunit>
