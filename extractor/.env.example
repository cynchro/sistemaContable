# CUIT del contribuyente a extraer (el mismo con el que se loguea en ARCA).
ARCA_CUIT=

# Clave Fiscal para que "npm run login" complete el formulario solo (headless,
# corre incluso dentro de Docker). Es TU credencial, la ponés y la corrés VOS
# — no es algo que un asistente de IA deba leer ni usar nunca. No commitees
# este archivo con un valor real.
ARCA_CLAVE_FISCAL=

# Carpeta donde se persiste la sesión de Playwright (storageState) para no
# volver a loguear en cada corrida.
PLAYWRIGHT_STORAGE_DIR=.sessions

# true = headless (login automatizado con ARCA_CLAVE_FISCAL, anda en Docker).
# false = navegador visible — usar SOLO si el login headless falló con
# LoginNoConfirmadoError (ARCA pidió una verificación adicional que hay que
# resolver a mano una vez; después la sesión guardada evita que vuelva a pasar).
PLAYWRIGHT_HEADLESS=true

# API de ecosistema (backend Modux). La API key se genera desde Admin > API
# Keys con scopes iva.compras, iva.ventas, iva.libro (ver
# App\Modules\ApiKeys\Controllers\ApiKeyController) — nunca uses una clave de
# usuario/contraseña acá. En local: http://localhost:8077.
#
# Si vas a correr el modo `worker` (docker compose up -d extractor-worker, botón
# "Liquidar IVA" — ver src/cli/worker.ts), la key necesita ADEMÁS los scopes
# iva.liquidaciones.worker (tomar pedidos de la cola / reportar estado) e
# iva.liquidaciones.credencial (pedir la Clave Fiscal de un CUIT SOLO cuando su
# sesión guardada expiró — nunca se persiste, se usa una vez y se descarta).
# El modo worker NO usa ARCA_CUIT/ARCA_CLAVE_FISCAL de este .env: cada
# liquidación de la cola trae su propio CUIT, y ese CUIT necesita una sesión
# ya bootstrapeada (ver arriba, "npm run login" corrido una vez a mano para
# ese CUIT en particular) antes de que el worker la pueda tomar sola.
ECOSISTEMA_BASE_URL=
ECOSISTEMA_API_KEY=
